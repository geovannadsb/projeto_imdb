                "    #\"Coluna Mesclada Inserida\" = Table.AddColumn(#\"Tipo Alterado2\", \"Receita\", each Text.Combine({Text.From([Receita_bruta_mundial], \"pt-BR\"), Text.From([Receita_EUA_Canada], \"pt-BR\")}, \"\"), type text),",
                "    #\"Colunas Removidas1\" = Table.RemoveColumns(#\"Coluna Mesclada Inserida\",{\"Receita\"}),",
