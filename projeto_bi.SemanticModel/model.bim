        "lineageTag": "8ef938a8-2d13-4fcb-a250-5f7e483c19cf",
        "measures": [
          {
            "name": "Contagem de filmes",
            "expression": "DISTINCTCOUNT(imdb_movies[ID])",
            "formatString": "0",
            "lineageTag": "707997af-14a0-4864-9614-67aacbda7e7a"
          },
          {
            "name": "Lucro ou Prejuizo total",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"pt-BR\"}"
              }
            ],
            "expression": "SUMX(imdb_movies, imdb_movies[Receita] - imdb_movies[Orçamento])",
            "formatString": "\"R$\"\\ #,0.###############;-\"R$\"\\ #,0.###############;\"R$\"\\ #,0.###############",
            "lineageTag": "98b40faf-0b2f-48ec-af79-f8f76132aa17"
          },
          {
            "name": "Media 2000's",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": "CALCULATE(AVERAGE(imdb_movies[Avaliação_imdb]), imdb_movies[Ano] >=2000)",
            "lineageTag": "7bfa78a1-205f-45bc-8365-f6e892179d16"
          },
          {
            "name": "Resultado_Financeiro",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"pt-BR\"}"
              }
            ],
            "expression": [
              "",
              "SUMX(",
              "    imdb_movies,",
              "    imdb_movies[Receita] - imdb_movies[Orçamento]",
              ")"
            ],
            "formatString": "\"R$\"\\ #,0.###############;-\"R$\"\\ #,0.###############;\"R$\"\\ #,0.###############",
            "lineageTag": "76e463f3-0e00-4891-8c5e-12d85bf84585"
          }
        ],
