                "    #\"Colunas Reordenadas\" = Table.ReorderColumns(#\"Personalização Adicionada\",{\"ID\", \"Título\", \"Ano\", \"Duração\", \"Classificação_indicativa\", \"Avaliação_imdb\", \"Voto\", \"Orçamento\", \"Receita\", \"Receita_bruta_mundial\", \"Receita_EUA_Canada\", \"Receita_semana_lançamento\", \"Diretor\", \"Escritor\", \"Estrela\", \"Gênero\", \"País_origem\", \"Local_filmagem\", \"Compania_produção\", \"Idioma\", \"Vitória\", \"Nomiações\", \"Oscar\"}),",
